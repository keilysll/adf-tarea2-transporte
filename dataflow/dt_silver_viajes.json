{
	"name": "dt_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(EstadoViaje = upper(trim(EstadoViaje)),",
				"          KmRecorridos = toDecimal(replace(trim(KmRecorridos),',','.'),8,1),",
				"          ValidacionesTarjeta = toInteger(trim(ValidacionesTarjeta)),",
				"          HoraLlegada = toTimestamp(concat('1970-01-01 ', trim(HoraLlegada), ':00'), 'yyyy-MM-dd HH:mm:ss'),",
				"          HoraSalida = toTimestamp(concat('1970-01-01 ', trim(HoraSalida), ':00'), 'yyyy-MM-dd HH:mm:ss'),",
				"          HoraProgramada = toTimestamp(concat('1970-01-01 ', trim(HoraProgramada), ':00'), 'yyyy-MM-dd HH:mm:ss'),",
				"          VehiculoId = concat('V-', lpad(regexReplace(trim(VehiculoId),'[^0-9]',''),3,'0')),",
				"          RutaHistoricaId = concat('R-', lpad(regexReplace(trim(RutaHistoricaId),'[^0-9]',''),2,'0'), '_20200101'),",
				"          FechaServicio = coalesce(toDate(trim(FechaServicio),'dd/MM/yyyy'), toDate(trim(FechaServicio),'yyyy-MM-dd'))) ~> derivedColumn1",
				"derivedColumn1 derive(ViajeId = concat(toString(year(FechaServicio)),'-',regexReplace(trim(ViajeId),'[^0-9]',''))) ~> derivedColumn2",
				"derivedColumn2 split(!isNull(ViajeId) && !isNull(RutaHistoricaId) && !isNull(VehiculoId) && !isNull(FechaServicio) && !isNull(HoraProgramada) && !isNull(HoraSalida) && !isNull(HoraLlegada) && !isNull(ValidacionesTarjeta) && !isNull(KmRecorridos) && !isNull(EstadoViaje) && HoraLlegada > HoraSalida,",
				"     disjoint: false) ~> split1@(valido, otros)",
				"split1@valido aggregate(groupBy(ViajeId,",
				"          {} = ERROR_FUNCTION('')),",
				"     columna1 = ERROR_FUNCTION(''),",
				"          each(match(name != 'ViajeId'), $$ = first($$))) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}
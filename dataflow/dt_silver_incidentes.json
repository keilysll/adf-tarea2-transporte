{
	"name": "dt_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = upper(trim(IncidenteId)),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 derive(FechaHoraInicio = iif(instr(trim(FechaHoraInicio),'-')>0, toTimestamp(trim(FechaHoraInicio),'yyyy-MM-dd'), toTimestamp(trim(FechaHoraInicio),'dd/MM/yyyy')),",
				"          FechaHoraFin = iif(instr(trim(FechaHoraFin),'-')>0, toTimestamp(trim(FechaHoraFin),'yyyy-MM-dd'), toTimestamp(trim(FechaHoraFin),'dd/MM/yyyy')),",
				"          FechaHoraRegistro = iif(instr(trim(FechaHoraRegistro),'-')>0, toTimestamp(trim(FechaHoraRegistro),'yyyy-MM-dd'), toTimestamp(trim(FechaHoraRegistro),'dd/MM/yyyy'))) ~> derivedColumn2",
				"derivedColumn2 derive(VehiculoId = iif(isNull(VehiculoId) || trim(VehiculoId)=='', toString(null()), upper(trim(VehiculoId)))) ~> derivedColumn3",
				"derivedColumn3 split(!isNull(IncidenteId) && !isNull(TipoIncidente) && !isNull(Severidad) && !isNull(FechaHoraInicio) && !isNull(FechaHoraFin) && !isNull(FechaHoraRegistro) && !isNull(Descripcion) && FechaHoraFin >= FechaHoraInicio && toDate(FechaHoraRegistro) >= toDate(FechaHoraInicio) && in(['AVERIA','ACCIDENTE_VIAL','CONGESTION','OBRA_VIAL','CLIMA'], TipoIncidente) && in(['BAJA','MEDIA','ALTA','CRITICA'], Severidad),",
				"     disjoint: false) ~> split1@(validos, otros)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}
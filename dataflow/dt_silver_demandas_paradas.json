{
	"name": "dt_silver_demandas_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demandas_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          Franja = trim(Franja),",
				"          Descensos = toInteger(trim(Descensos)),",
				"          DemandaNoAtendida = toInteger(trim(DemandaNoAtendida)),",
				"          Metodo = coalesce(Metodo, 'DESCONOCIDO'),",
				"          ValidacionesTarjeta = coalesce(toInteger(ValidacionesTarjeta), 0),",
				"          RutaHistoricaId =    concat('R-', lpad(regexReplace(RutaHistoricaId,'[^0-9]',''), 2, '0')),",
				"          FechaServicio = iif(instr(trim(FechaServicio),'-')>0, toDate(trim(FechaServicio),'yyyy-MM-dd'), toDate(trim(FechaServicio),'dd/MM/yyyy'))) ~> derivedColumn1",
				"derivedColumn1 derive(DemandaId = coalesce(DemandaId, concat('DM-', toString(FechaServicio,'yyyyMMdd'), '-', ParadaHistoricaId, '-', RutaHistoricaId, '-', replace(Franja,':',''))),",
				"          RutaHistoricaId =      concat(RutaHistoricaId,'_20200101')) ~> derivedColumn2",
				"derivedColumn2 aggregate(FechaServicio = first(FechaServicio),",
				"          RutaHistoricaId = first(RutaHistoricaId),",
				"          ParadaHistoricaId = first(ParadaHistoricaId),",
				"          Franja = first(Franja),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          Descensos = first(Descensos),",
				"          DemandaNoAtendida = first(DemandaNoAtendida),",
				"          Metodo = first(Metodo)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}